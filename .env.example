# ===================================================================
# Warehouse Training & Skill Management System
# Root Environment Variables Configuration Template (.env.example)
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration
# -------------------------------------------------------------------
PORT=5000

# Database Connection String (MySQL 8 / MariaDB)
# Local: mysql://root:root@localhost:3306/warehouse_db
# Docker: mysql://root:rootpassword@db:3306/warehouse_db
# Cloud DB (RDS/Cloud SQL/Azure): mysql://<user>:<password>@<host>:3306/<dbname>?ssl={"rejectUnauthorized":false}
DATABASE_URL=mysql://root:rootpassword@localhost:3306/warehouse_db

# JWT Secret Key for Token Signatures (Must change in production)
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production

# Fallback mode (false = use real MySQL DB, true = fallback to memory mock data)
USE_MOCK_DB=false

# Environment Mode ('development' | 'production')
NODE_ENV=production

# -------------------------------------------------------------------
# Frontend Configuration
# -------------------------------------------------------------------
# Backend API Base URL (Must be accessible from client web browsers)
# Local: http://localhost:5000
# Production Domain: https://api.yourcompany.com (or http://<SERVER_IP>:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
